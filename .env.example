# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Free Tier Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# Payment Gateway (Razorpay / Cashfree / PhonePe sandbox)
PAYMENT_GATEWAY_KEY=your-merchant-public-key
PAYMENT_GATEWAY_SECRET=your-merchant-secret-key

# Distance & Maps Services
MAPS_API_KEY=your-maps-api-key

# Communication Providers
EMAIL_PROVIDER_API_KEY=your-email-provider-key
SMS_PROVIDER_API_KEY=your-sms-provider-key

# Confidential Platform & Developer Financial Configuration
DEVELOPER_PAYMENT_EMAIL=developer@example.com
PRIVATE_UPI_IDENTIFIER=merchant@upi
COMMISSION_PERCENTAGE=10

